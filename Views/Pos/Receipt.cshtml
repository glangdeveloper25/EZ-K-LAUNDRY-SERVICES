@model EZKLaundrySystem.Models.PosReceiptVM
@{
    Layout = null;
    var posMessage = TempData["PosMessage"] as string;
    string Label(string name) => name switch
    {
        "Washing" => "Wash", "Drying" => "Dry", "Folding" => "Fold",
        "Powder" => "Powder Soap", "Downy" => "Downy Softener", _ => name
    };
    string Detail(EZKLaundrySystem.Models.PosReceiptLine line) => line.ChargingBasis switch
    {
        "PerLoad" => $"{line.Quantity:0.##} load{(line.Quantity == 1 ? "" : "s")} × ₱{line.UnitPrice:N2}",
        "PerKg" => $"{line.Quantity:0.##} kg × ₱{line.UnitPrice:N2}",
        "PerItem" when line.UnitPrice == 0m => $"{line.Quantity:0.##} · included in the package",
        "PerItem" => $"{line.Quantity:0.##} × ₱{line.UnitPrice:N2}",
        _ => ""
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt @Model.BookingCode</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #f1f5f9; font-family: 'Segoe UI', Arial, sans-serif; color: #10203b; }
        .receipt { max-width: 380px; margin: 24px auto; background: #fff; border-radius: 12px; padding: 22px 24px; box-shadow: 0 6px 20px rgba(15,23,42,.08); font-size: .9rem; }
        .receipt img { max-width: 140px; }
        .line { display: flex; justify-content: space-between; gap: 8px; padding: 4px 0; }
        .line small { display: block; color: #64748b; }
        .dash { border-top: 2px dashed #cbd5e1; margin: 10px 0; }
        .total { font-size: 1.25rem; font-weight: 800; }
        .actions { max-width: 380px; margin: 0 auto 24px; }
        @@media print {
            body { background: #fff; }
            .receipt { box-shadow: none; margin: 0 auto; }
            .actions, .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    @if (!string.IsNullOrWhiteSpace(posMessage))
    {
        <div class="alert alert-success text-center no-print mb-0 rounded-0"><i class="bi bi-check-circle-fill me-1"></i>@posMessage</div>
    }
    <div class="receipt">
        <div class="text-center mb-2">
            <img src="~/images/ezk-laundry-logo.png" alt="EZ-K Laundry Services" />
            <div class="small text-muted">CSA Building, Abdawa St., Brgy. Dadiangas North, General Santos City</div>
        </div>
        <div class="dash"></div>
        <div class="line"><span>Booking code</span><b>@Model.BookingCode</b></div>
        <div class="line"><span>Date</span><span>@Model.BookedAt.ToString("MMM d, yyyy h:mm tt")</span></div>
        <div class="line"><span>Customer</span><span>@Model.CustomerName</span></div>
        @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
        {
            <div class="line"><span>Contact</span><span>@Model.CustomerPhone</span></div>
        }
        <div class="line"><span>Service</span><span>@(Model.ServiceMode == EZKLaundrySystem.Models.ServiceRules.SelfService ? "Self-Service" : "Full-Service")@(Model.IsRush ? " · RUSH" : "")</span></div>
        <div class="line"><span>Weight</span><span>@Model.Weight.ToString("0.##") kg</span></div>
        <div class="dash"></div>
        @foreach (var line in Model.Lines)
        {
            <div class="line"><div>@Label(line.Name)<small>@Detail(line)</small></div><b>₱@line.Amount.ToString("N2")</b></div>
        }
        @if (Model.Notes.Contains("Customer will bring their own"))
        {
            <div class="small text-muted mt-1">Customer's own supplies used (no charge).</div>
        }
        <div class="dash"></div>
        <div class="line total"><span>TOTAL</span><span>₱@Model.Total.ToString("N2")</span></div>
        @foreach (var payment in Model.Payments)
        {
            <div class="line"><span>Paid · @payment.Method@(string.IsNullOrEmpty(payment.Reference) ? "" : $" (Ref {payment.Reference})")</span><span>₱@payment.Amount.ToString("N2")</span></div>
            @if (payment.Notes.StartsWith("POS cash payment"))
            {
                <div class="small text-muted">@payment.Notes.Replace("POS cash payment. ", "")</div>
            }
        }
        <div class="line fw-bold"><span>Balance</span><span>₱@Model.Balance.ToString("N2")</span></div>
        <div class="dash"></div>
        <div class="text-center small text-muted">
            Served by @(string.IsNullOrWhiteSpace(Model.StaffName) ? "Staff" : Model.StaffName)<br />
            Present this booking code when claiming your laundry.<br />
            <b>See you, ka-labada!</b>
        </div>
    </div>
    <div class="actions d-flex gap-2">
        <button type="button" class="btn btn-primary flex-grow-1" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print Receipt</button>
        <a href="@Url.Action("Index", "Pos")" class="btn btn-outline-secondary flex-grow-1"><i class="bi bi-plus-lg me-1"></i>New Order</a>
    </div>
</body>
</html>
