<!-- SCRIPT LOGIC -->
@if (isHome)
{
    <script>
        // Live Tracking auto-update: check every 15 seconds while the tab is visible; reload only when something changed.
        (function () {
            const rendered = @Json.Serialize(EZKLaundrySystem.Controllers.CustomerController.TrackingSignature(Model.ActiveBookings, Model.UnreadNotificationCount));
            const url = '@Url.Action("TrackingStatus", "Customer")';
            async function check() {
                if (document.hidden) return;
                try {
                    const response = await fetch(url, { cache: 'no-store', headers: { 'Accept': 'application/json' } });
                    if (!response.ok) return;
                    const data = await response.json();
                    if (data.signature !== rendered) {
                        try { sessionStorage.setItem('ezkOrderTab', document.querySelector('.order-tab.active')?.id ?? ''); } catch { }
                        location.reload();
                    }
                } catch { /* offline or server restarting: try again on the next tick */ }
            }
            setInterval(check, @(EZKLaundrySystem.Controllers.CustomerController.TrackingPollSeconds * 1000));
            document.addEventListener('visibilitychange', () => { if (!document.hidden) check(); });
        })();
    </script>
}
<script>
    function showOrderTab(name) {
        document.querySelectorAll('.order-tab').forEach(tab => {
            const selected = tab.id === 'order-tab-' + name;
            tab.classList.toggle('active', selected);
            tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        });
        document.querySelectorAll('.order-panel').forEach(panel => panel.hidden = panel.id !== 'order-panel-' + name);
    }

    // After an auto-update reload, reopen the tab the customer was looking at.
    try {
        const savedTab = sessionStorage.getItem('ezkOrderTab');
        sessionStorage.removeItem('ezkOrderTab');
        if (savedTab && document.getElementById(savedTab)) showOrderTab(savedTab.replace('order-tab-', ''));
    } catch { }

    let selectedServicesArray = Array.from(document.querySelectorAll('.service-card.active'))
        .map(card => card.dataset.service);
    const isFullService = () => document.querySelector('input[name="serviceMode"]:checked')?.value !== 'Self Service';
    function showSelectedServices() {
        document.querySelectorAll('.service-card[data-service]').forEach(card =>
            card.classList.toggle('active', selectedServicesArray.includes(card.dataset.service)));
        document.getElementById('selectedServices').value = selectedServicesArray.join(', ');
    }

    // Full-Service is EZ-K's wash-dry-fold package; Self-Service is wash and/or dry only.
    function syncServiceMode() {
        const full = isFullService();
        selectedServicesArray = full
            ? ['Washing', 'Drying', 'Folding']
            : selectedServicesArray.filter(service => service !== 'Folding');
        showSelectedServices();
        document.querySelectorAll('[data-full-only]').forEach(element => element.hidden = !full);
        document.querySelectorAll('[data-self-only]').forEach(element => {
            element.hidden = full;
            element.querySelectorAll('.supply-source').forEach(select => { select.disabled = full; if (!full) updateSupplyChoice(select); });
            if (full) element.querySelectorAll('.supply-quantity input, .supply-quantity select').forEach(field => { field.disabled = true; field.required = false; });
        });
        syncPackageSupplies();
        updateEstimate();
    }

    // Estimated total shown in the bottom bar; the same rules the server uses when it saves the booking.
    function updateEstimate() {
        const form = document.getElementById('bookingForm');
        if (!form) return;
        const price = name => Number(form.dataset[name] || 0);
        const kg = Number(document.getElementById('weightInput').value);
        const loads = kg > 0 ? Math.ceil(kg / price('kgPerLoad')) : 0;
        document.getElementById('loadCount').textContent = loads;
        document.getElementById('loadWord').textContent = loads === 1 ? 'load' : 'loads';

        const full = isFullService();
        let total = 0;
        if (full) {
            total += (price('wash') + price('dry') + price('fold')) * loads;
            if (document.querySelector('input[name="packageSupplies"]:checked')?.value === 'Shop') {
                total += price('packageFee') * loads;
                ['packageDetergentId', 'packageFabconId'].forEach(id =>
                    total += Number(document.getElementById(id).selectedOptions[0]?.dataset.extra || 0) * loads);
            }
            if (document.getElementById('addRushFee')?.checked) total += price('rush');
        } else {
            if (selectedServicesArray.includes('Washing')) total += price('wash') * loads;
            if (selectedServicesArray.includes('Drying')) total += price('dry') * loads;
            [['detergentSource', 'detergentProductId', 'powderQuantity'], ['softenerSource', 'softenerProductId', 'downyQuantity']]
                .forEach(([source, product, quantity]) => {
                    if (document.getElementById(source).value !== 'Shop') return;
                    const unitPrice = Number(document.getElementById(product).selectedOptions[0]?.dataset.price || 0);
                    total += unitPrice * Number(document.getElementById(quantity).value || 0);
                });
        }
        if (document.getElementById('useReward')?.checked && total >= price('rewardDiscount')) total -= price('rewardDiscount');

        document.getElementById('estimateTotal').textContent = '₱' + total.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const schedule = document.querySelector('.ds-time.on')?.dataset.label;
        document.getElementById('estimateMeta').textContent = ['Estimated total', full ? 'Full-Service' : 'Self-Service',
            loads + (loads === 1 ? ' load' : ' loads'), schedule].filter(Boolean).join(' · ');
    }

    document.querySelectorAll('[data-kg-step]').forEach(button => button.addEventListener('click', () => {
        const input = document.getElementById('weightInput');
        const next = Math.min(Number(input.max), Math.max(Number(input.min), (Number(input.value) || 0) + Number(button.dataset.kgStep)));
        input.value = String(Math.round(next * 100) / 100);
        updateEstimate();
    }));
    document.querySelectorAll('.bk-toggle').forEach(card => card.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); card.click(); }
    }));
    document.getElementById('bookingForm')?.addEventListener('input', updateEstimate);
    document.getElementById('bookingForm')?.addEventListener('change', updateEstimate);

    function syncPackageSupplies() {
        const useShop = isFullService() && document.querySelector('input[name="packageSupplies"]:checked')?.value === 'Shop';
        document.getElementById('packageBrands').hidden = !useShop;
        document.querySelectorAll('#packageBrands select').forEach(select => { select.disabled = !useShop; select.required = useShop; });
        document.querySelectorAll('input[name="packageSupplies"]').forEach(radio => radio.disabled = !isFullService());
    }

    function toggleService(name, element) {
        if (isFullService()) return;
        if (selectedServicesArray.includes(name)) {
            selectedServicesArray = selectedServicesArray.filter(item => item !== name);
            element.classList.remove('active');
        } else {
            selectedServicesArray.push(name);
            document.querySelectorAll('.service-card[data-service]').forEach(card =>
                card.classList.toggle('active', selectedServicesArray.includes(card.dataset.service)));
        }
        document.getElementById('selectedServices').value = selectedServicesArray.join(', ');
        syncSelfServiceRush();
        updateEstimate();
    }

    function syncSelfServiceRush() {
        const rush = document.getElementById('addRushFee');
        const selfService = document.querySelector('input[name="serviceMode"]:checked')?.value === 'Self Service';
        const machineAvailability = document.getElementById('selfServiceMachineAvailability');
        if (machineAvailability) machineAvailability.hidden = !selfService;
        if (!rush) return;
        if (selfService && rush.checked) {
            rush.checked = false;
            toggleAddonCard(rush);
        }
        rush.disabled = selfService;
        rush.title = selfService ? 'Rush Fee is not available for Self Service.' : '';
    }
    document.querySelectorAll('.service-mode').forEach(radio => radio.addEventListener('change', syncServiceMode));

    function toggleAddonCard(checkbox) {
        checkbox.closest('.addon-card').classList.toggle('active', checkbox.checked);
    }

    function updateSupplyChoice(select) {
        const buyFromShop = select.value === 'Shop';
        const bringOwn = select.value === 'Customer';
        const card = select.closest('.addon-card');
        const quantity = document.getElementById(select.dataset.quantityId);
        quantity.closest('.supply-quantity').querySelectorAll('input, select').forEach(field => {
            field.disabled = !buyFromShop;
            field.required = buyFromShop;
        });
        quantity.closest('.supply-quantity').hidden = !buyFromShop;
        card.classList.toggle('active', buyFromShop);
        card.classList.toggle('customer-supply', bringOwn);
        document.getElementById(select.dataset.helpId).textContent = buyFromShop
            ? 'Choose the brand. The selected shop quantity will be added to your bill.'
            : bringOwn
                ? 'Please bring your own product. No shop-product charge.'
                : select.value === 'None'
                    ? 'No product requested. No shop-product charge.'
                    : 'Please choose a source before reviewing your order.';
    }

    document.querySelectorAll('.supply-source').forEach(updateSupplyChoice);
    syncSelfServiceRush();
    syncServiceMode();

    // Drop-off schedule: pick a date card, then one of that date's time slots.
    const appointmentInput = document.getElementById('appointment');
    function showScheduleDay(dayButton) {
        document.querySelectorAll('.ds-day').forEach(button => button.classList.toggle('on', button === dayButton));
        document.querySelectorAll('.ds-times').forEach(group => group.hidden = group.dataset.timesFor !== dayButton.dataset.day);
        document.getElementById('dsTimeHeading').textContent = 'TIME · ' + dayButton.dataset.label.toUpperCase();
    }
    function chooseScheduleTime(timeButton) {
        document.querySelectorAll('.ds-time').forEach(button => button.classList.toggle('on', button === timeButton));
        appointmentInput.value = timeButton.dataset.slot;
        document.getElementById('dsChosenText').textContent = timeButton.dataset.label;
        document.getElementById('dsChosen').hidden = false;
        updateEstimate();
    }
    document.querySelectorAll('.ds-day').forEach(button => button.addEventListener('click', () => showScheduleDay(button)));
    document.querySelectorAll('.ds-time').forEach(button => button.addEventListener('click', () => chooseScheduleTime(button)));
    (function restoreSchedule() {
        const saved = [...document.querySelectorAll('.ds-time')].find(button => button.dataset.slot === appointmentInput.value && !button.disabled);
        if (saved) {
            showScheduleDay(document.querySelector(`.ds-day[data-day="${saved.closest('.ds-times').dataset.timesFor}"]`));
            chooseScheduleTime(saved);
            return;
        }
        appointmentInput.value = '';
        const firstOpenDay = document.querySelector('.ds-day:not(:disabled)');
        if (firstOpenDay) showScheduleDay(firstOpenDay);
    })();

    document.getElementById('bookingForm').addEventListener('submit', function(e) {
        if (selectedServicesArray.length === 0) {
            e.preventDefault();
            alert("Please select at least one service before booking.");
        } else if (!appointmentInput.value) {
            e.preventDefault();
            alert("Please choose a drop-off date and time before booking.");
            document.getElementById('dsTimeHeading')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });
</script>
<script src="~/js/customer-history.js" asp-append-version="true"></script>
