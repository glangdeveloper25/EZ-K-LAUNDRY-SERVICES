@{ Layout = "_Layout"; }

<div class="container-fluid d-flex align-items-center justify-content-center" style="min-height: 100vh; background-color: #f8fafc;">
    <div class="card shadow-sm border-0 p-5 text-center" style="width: 450px; border-radius: 12px; border-top: 5px solid #22c55e !important;">
        
        <div class="d-inline-block p-3 rounded-circle mb-3" style="background-color: #dcfce7; color: #16a34a;">
            <i class="bi bi-lock-fill fs-3"></i>
        </div>
        
        <h4 class="fw-bold mb-1">Owner Login</h4>
        <p class="text-muted small mb-4">Enter your credentials for admin access.</p>

        <!-- Admin Reminder (Gaya sa PDF) -->
        <div class="alert text-start p-3 mb-4" style="background-color: #ccfbf1; border: 1px solid #99f6e4; border-radius: 8px;">
            <div class="d-flex gap-2">
                <i class="bi bi-shield-lock text-success mt-1"></i>
                <div>
                    <h6 class="fw-bold text-success mb-1 small">Admin Reminder</h6>
                    <p class="mb-0 text-success" style="font-size: 11px; line-height: 1.5;">This portal is for EZ-K Laundry owners only. Here, you can manage staff accounts and view total sales.</p>
                </div>
            </div>
        </div>

        <form asp-action="Login" method="post" class="text-start">
            <div class="mb-3">
                <label class="small text-muted mb-1">Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-person text-muted"></i></span>
                    <input type="text" name="email" class="form-control border-start-0 ps-0" placeholder="admin@ezk-laundry.com" required />
                </div>
            </div>
            <div class="mb-4">
                <div class="d-flex justify-content-between mb-1">
                    <label class="small text-muted">Password</label>
                    @* Forgot password is a recommendation for future work. <a href="#" class="small text-decoration-none" style="font-size: 11px;">Forgot Password?</a> *@
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
                    <input type="password" name="password" class="form-control border-start-0 ps-0" placeholder="********" required />
                </div>
            </div>
            
            <button type="submit" class="btn w-100 fw-bold py-2 mb-4 text-white shadow-sm" style="background-color: #6366f1;">Login as Owner</button>
        </form>

        <div class="position-relative mb-4">
            <hr class="text-muted">
            <span class="position-absolute top-50 start-50 translate-middle px-2 bg-white small text-muted" style="font-size: 10px;">OTHER OPTIONS</span>
        </div>

        <!-- Back to Customer Portal Button -->
        <a href="/Account/Login" class="btn btn-outline-dark w-100 py-2 fw-bold" style="border-radius: 8px;">Back to Customer Portal</a>
        <div class="mt-3"><span class="badge border text-muted px-3 py-1 rounded-pill">Authorized Access Only</span></div>
    </div>
</div>