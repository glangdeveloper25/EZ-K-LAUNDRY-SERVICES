@model EZKLaundrySystem.Models.User
@{ Layout = "_Layout"; }

<style>
    body { background-color: #f8fafc; font-family: 'Inter', sans-serif; }
    .reg-header { margin-top: 60px; margin-bottom: 40px; }
    .reg-header h1 { font-size: 3rem; font-weight: 800; color: #1e293b; }
    .form-card { background: white; padding: 40px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
    .form-label { font-weight: 600; color: #475569; font-size: 0.85rem; margin-bottom: 8px; }
    .form-control { border-radius: 8px; padding: 12px; border: 1px solid #e2e8f0; }
    .btn-reg { background-color: #6366f1; color: white !important; font-weight: 700; padding: 15px; border-radius: 10px; width: 100%; border: none; font-size: 1rem; transition: 0.3s; }
    .btn-reg:hover { background-color: #4f46e5; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4); }
</style>

<div class="container pb-5">
    <div class="text-center reg-header">
        <h1>Welcome!</h1>
        <p class="text-muted fs-5">Register Your Laundry Shop</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <form asp-action="RegisterShop" method="post" class="form-card">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                
                <div class="mb-4">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="FullName" class="form-control" placeholder="Juan Dela Cruz" required />
                </div>
                
                <div class="mb-4">
                    <label class="form-label">Email</label>
                    <input type="email" name="Email" class="form-control" placeholder="owner@shop.com" required />
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Password</label>
                        <input type="password" name="Password" class="form-control" placeholder="Create a strong password" minlength="8" maxlength="128" autocomplete="new-password" required />
                        <div class="form-text">Uppercase, lowercase, number, and special character.</div>
                    </div>
                    <div class="col-md-6 mt-4 mt-md-0">
                        <label class="form-label">Confirm password</label>
                        <input type="password" name="ConfirmPassword" class="form-control" placeholder="Re-enter password" autocomplete="new-password" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Shop Name</label>
                    <input type="text" name="ShopName" class="form-control" placeholder="e.g. EZ-K Laundry Services" required />
                </div>

                <div class="row mb-5">
                    <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input type="text" name="Address" class="form-control" placeholder="e.g. CSA Building, Abdawa Street" required />
                    </div>
                    <div class="col-md-6 mt-4 mt-md-0">
                        <label class="form-label">Contact Number</label>
                        <input type="text" name="ContactNumber" class="form-control" placeholder="09XXXXXXXXX" required />
                    </div>
                </div>
                
                <div class="text-center mt-3">
                    <button type="submit" class="btn-reg w-50">Register</button>
                </div>
            </form>
        </div>
    </div>
</div>
