                </div>
                <div class="col-md-2"><label class="fw-bold small text-muted mb-2" for="newProductPrice">Price</label><div class="input-group"><span class="input-group-text bg-light">₱</span><input id="newProductPrice" name="price" type="number" class="form-control" min="0" step="0.01" required></div></div>
                <div class="col-md-2"><button type="submit" class="btn btn-ezk w-100"><i class="bi bi-plus-lg me-1"></i>Add</button></div>
                <div class="col-12 small text-muted">New products start with 0 stock. Record the stock received under Inventory → Stock In.</div>
            </form>
        </div>
    </div>

</div>

