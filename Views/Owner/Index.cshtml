                    </div>
                    <div class="col-md-3">
                        <label class="fw-bold small text-muted mb-2">Drying (per load)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₱</span>
                            <input type="number" name="Drying" class="form-control py-2" value="@(Model.Pricing.ContainsKey("Drying") ? Model.Pricing["Drying"] : 25.00m)" step="0.01" required>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="fw-bold small text-muted mb-2">Folding (per load)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₱</span>
                            <input type="number" name="Folding" class="form-control py-2" value="@(Model.Pricing.ContainsKey("Folding") ? Model.Pricing["Folding"] : 10.00m)" step="0.01" required>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="fw-bold small text-muted mb-2">Kilos per load</label>
                        <div class="input-group">
                            <input type="number" name="KgPerLoad" class="form-control py-2" value="@Model.KgPerLoad.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="1" max="50" step="0.01" required>
