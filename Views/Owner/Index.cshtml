                    <table class="table align-middle mb-0">
                        <thead class="table-light"><tr><th>Product</th><th>Type</th><th style="width:150px">Sachet price</th><th style="width:150px">Full-Service extra / load</th><th>Stock</th><th class="text-end">Shown to staff &amp; customers</th></tr></thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                int stock = product.Stock ?? 0;
                                <tr class="@(product.IsActive ? "" : "text-muted")">
                                    <td class="fw-semibold">@product.Name</td>
                                    <td>@product.ProductType</td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light">₱</span>
                                            <input type="number" name="ProductPrices[@product.ServiceId]" class="form-control" value="@product.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" required>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light">+₱</span>
                                            <input type="number" name="ProductExtras[@product.ServiceId]" class="form-control" value="@product.PackageExtra.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" required title="Added per load when this product is used in the Full-Service package (e.g. Ariel +₱3)">
                                        </div>
                                    </td>
                                    <td>
                                        @if (!product.IsActive) { <span>—</span> }
                                        else if (stock <= 0) { <span class="text-danger fw-bold"><i class="bi bi-x-circle-fill me-1"></i>0 · Out of stock</span> }
                                        else if (stock <= EZKLaundrySystem.Models.InventorySnapshot.LowStockLevel) { <span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i>@stock · Low</span> }
                                        else { <span>@stock pcs</span> }
                                    </td>
                                    <td class="text-end">
                                        <button type="submit" form="toggleProduct@(product.ServiceId)" class="btn btn-sm @(product.IsActive ? "btn-outline-secondary" : "btn-outline-success")">@(product.IsActive ? "Hide" : "Show")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="small text-muted mt-2">Record stock received under <a asp-controller="Inventory" asp-action="Index">Inventory → Stock In</a>.</div>
                </div>

                <!-- SPECIAL FEES & LOGISTICS -->
