<script>
    // Each staff password field can be revealed independently; closing the modal hides both again.
    (function () {
        const modal = document.getElementById('staffModal');
        const buttons = modal.querySelectorAll('.staff-password-toggle');
        const contactNumber = document.getElementById('staffContactNumber');

        contactNumber.addEventListener('paste', function (event) {
            if (!event.clipboardData) return;
            event.preventDefault();
            const start = contactNumber.selectionStart ?? contactNumber.value.length;
            const end = contactNumber.selectionEnd ?? start;
            const remaining = Math.max(0, 11 - (contactNumber.value.length - (end - start)));
            const digits = event.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, remaining);
            contactNumber.setRangeText(digits, start, end, 'end');
            contactNumber.dispatchEvent(new Event('input', { bubbles: true }));
        });

        contactNumber.addEventListener('input', function () {
            const original = contactNumber.value;
            const sanitized = original.replace(/[^0-9]/g, '').slice(0, 11);
            if (original === sanitized) return;
            const cursor = contactNumber.selectionStart;
            contactNumber.value = sanitized;
            if (cursor !== null) {
                const position = Math.min(original.slice(0, cursor).replace(/[^0-9]/g, '').length, sanitized.length);
                contactNumber.setSelectionRange(position, position);
            }
        });

        function setVisibility(button, visible) {
            const field = document.getElementById(button.getAttribute('aria-controls'));
            field.type = visible ? 'text' : 'password';
            button.querySelector('i').classList.toggle('bi-eye', !visible);
            button.querySelector('i').classList.toggle('bi-eye-slash', visible);
            const label = (visible ? 'Hide ' : 'Show ') + button.dataset.passwordLabel;
            button.setAttribute('aria-label', label);
            button.setAttribute('aria-pressed', String(visible));
            button.title = label;
        }

        buttons.forEach(button => button.addEventListener('click', function () {
            const field = document.getElementById(button.getAttribute('aria-controls'));
            setVisibility(button, field.type === 'password');
        }));

        function hidePasswords() {
            buttons.forEach(button => setVisibility(button, false));
        }

        modal.addEventListener('hidden.bs.modal', hidePasswords);
        modal.querySelector('form').addEventListener('reset', hidePasswords);
        modal.querySelector('form').addEventListener('submit', hidePasswords);
    })();

    // SIDEBAR NAVIGATION SCRIPT
    function showSection(sectionId, el) {
        document.querySelectorAll('.section-content').forEach(s => s.classList.remove('active'));
        document.getElementById(sectionId).classList.add('active');
        document.querySelectorAll('.nav-link-owner').forEach(l => l.classList.remove('active'));
        el.classList.add('active');
    }

    function updateReportPeriodFields() {
        const selectedPeriod = document.getElementById('reportPeriod').value;
        document.querySelectorAll('.report-period-field').forEach(field => {
            const periods = field.dataset.periods.split(',');
            field.style.display = periods.includes(selectedPeriod) ? 'block' : 'none';
        });
    }

    function printTransactionReport() {
        if (document.body.classList.contains('print-transaction-report')) return;
        setOwnerReportPrintDate('transactionReportPrintDate');
        const pageStyle = document.createElement('style');
        pageStyle.textContent = '@@page { size: A4 portrait; margin: 10mm; }';
        // Apply the transaction document's margins without changing other reports.
        document.body.appendChild(pageStyle);
        document.body.classList.add('print-transaction-report');
        // Keep the dedicated report document visible until printing is finished or cancelled.
        // Some browsers return from print() before the dialog closes.
        const cleanup = () => {
            document.body.classList.remove('print-transaction-report');
            pageStyle.remove();
            window.removeEventListener('afterprint', cleanup);
        };
        window.addEventListener('afterprint', cleanup, { once: true });
        try {
            window.print();
        } catch (error) {
            cleanup();
            throw error;
        }
    }

    function printMonthlyIncomeReport() {
        const printDate = document.getElementById('incomeReportPrintDate');
        printDate.textContent = new Intl.DateTimeFormat('en-PH', {
            dateStyle: 'long',
            timeStyle: 'short'
        }).format(new Date());
        window.print();
    }

    function setOwnerReportPrintDate(elementId) {
        document.getElementById(elementId).textContent = new Intl.DateTimeFormat('en-PH', {
            dateStyle: 'long',
            timeStyle: 'short'
        }).format(new Date());
    }

    function printLaundryOperations() {
        if (document.body.classList.contains('print-laundry-operations')) return;
        setOwnerReportPrintDate('laundryOperationsPrintDate');
        const pageStyle = document.createElement('style');
        pageStyle.textContent = '@@page { size: A4 portrait; margin: 10mm; }';
        document.body.appendChild(pageStyle);
        document.body.classList.add('print-laundry-operations');
        // Preserve both the report and the current dashboard page until printing ends.
        const cleanup = () => {
            document.body.classList.remove('print-laundry-operations');
            pageStyle.remove();
            window.removeEventListener('afterprint', cleanup);
        };
        window.addEventListener('afterprint', cleanup, { once: true });
        try {
            window.print();
        } catch (error) {
            cleanup();
            throw error;
        }
    }

    function printCustomerRecords() {
        if (document.body.classList.contains('print-customer-records')) return;
        setOwnerReportPrintDate('customerRecordsPrintDate');
        const pageStyle = document.createElement('style');
        pageStyle.textContent = '@@page { size: A4 portrait; margin: 10mm; }';
        document.body.appendChild(pageStyle);
        document.body.classList.add('print-customer-records');
        // Keep the report available until the print dialog closes or is cancelled.
        const cleanup = () => {
            document.body.classList.remove('print-customer-records');
            pageStyle.remove();
            window.removeEventListener('afterprint', cleanup);
        };
        window.addEventListener('afterprint', cleanup, { once: true });
        try {
            window.print();
        } catch (error) {
            cleanup();
            throw error;
        }
    }

    function printCustomerBookings(customerId) {
        const customerModal = document.getElementById(`custModal-${customerId}`);
        setOwnerReportPrintDate(`customerBookingsPrintDate-${customerId}`);
        customerModal.classList.add('print-target-modal');
        document.body.classList.add('print-customer-bookings');
        try {
            window.print();
        } finally {
            document.body.classList.remove('print-customer-bookings');
            customerModal.classList.remove('print-target-modal');
        }
    }

    const laundryOperationsRows = Array.from(document.querySelectorAll('.laundry-operation-row'));
    const laundryOperationsPageSize = 22;
    let laundryOperationsCurrentPage = 1;

    function renderLaundryOperationsPage() {
        const totalRows = laundryOperationsRows.length;
        const totalPages = Math.max(1, Math.ceil(totalRows / laundryOperationsPageSize));
        laundryOperationsCurrentPage = Math.min(Math.max(laundryOperationsCurrentPage, 1), totalPages);

        const startIndex = (laundryOperationsCurrentPage - 1) * laundryOperationsPageSize;
        const endIndex = Math.min(startIndex + laundryOperationsPageSize, totalRows);

        laundryOperationsRows.forEach((row, index) => {
            row.style.display = index >= startIndex && index < endIndex ? '' : 'none';
        });

        document.getElementById('laundryOperationsRange').textContent = totalRows === 0
            ? '0-0 of 0'
            : `${startIndex + 1}-${endIndex} of ${totalRows}`;
        document.getElementById('laundryOperationsPrevious').disabled = laundryOperationsCurrentPage === 1 || totalRows === 0;
        document.getElementById('laundryOperationsNext').disabled = laundryOperationsCurrentPage === totalPages || totalRows === 0;
    }

    function changeLaundryOperationsPage(direction) {
        laundryOperationsCurrentPage += direction;
        renderLaundryOperationsPage();
    }

    updateReportPeriodFields();
    renderLaundryOperationsPage();

    @if (Model.OpenReports)
    {
        <text>showSection('reports', document.getElementById('btn-reports'));</text>
    }
</script>
<script src="~/js/dashboard-navigation.js" asp-append-version="true" data-preserve-current-section="@(Model.OpenReports ? "true" : "false")"></script>
