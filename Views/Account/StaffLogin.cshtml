@{
    Layout = "_Layout";
}

<div class="container-fluid d-flex align-items-center justify-content-center" style="min-height: 100vh; background-color: #f3f4f6;">
    <div class="card shadow-sm border-0 p-5 text-center" style="width: 450px; border-radius: 20px; background: white;">
        <p class="text-primary fw-bold mb-1 small" style="letter-spacing: 1px;">INTERNAL OPERATIONS</p>
        <h3 class="fw-bold mb-4 text-dark">Welcome Back!</h3>
        <p class="text-muted small mb-5">Enter your credentials to access the order management system.</p>

        <form asp-controller="Account" asp-action="StaffLogin" method="post">
            <div class="text-start mb-3">
                <label class="small fw-bold mb-1">Username o Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                    <input type="text" name="email" class="form-control border-start-0 py-2" placeholder="juan.delacruz" required>
                </div>
            </div>
            <div class="text-start mb-5">
                <div class="d-flex justify-content-between">
                    <label class="small fw-bold mb-1">Password</label>
                    @* Forgot password is a recommendation for future work. <a href="#" class="small text-decoration-none">Forgot?</a> *@
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input type="password" name="password" class="form-control border-start-0 py-2" placeholder="********" required>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-sm" style="background-color: #6366f1; border-radius: 12px;">Login as Staff</button>
        </form>

        <div class="mt-5 p-3 bg-light rounded-3 text-start border-start border-primary border-4">
            <div class="d-flex gap-2">
                <i class="bi bi-info-circle-fill text-primary"></i>
                <div>
                    <p class="fw-bold small mb-1 text-dark">Reminder for Staff</p>
                    <p class="text-muted mb-0" style="font-size: 11px;">Your account can only be created by the Owner. If you do not have access, please contact your supervisor.</p>
                </div>
            </div>
        </div>
        
        <div class="mt-4">
            <a href="/Account/Login" class="small text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back to Customer Login</a>
        </div>
        
        <div class="mt-5 pt-3 d-flex justify-content-center gap-3 small text-muted opacity-75">
            <span>● System Online</span>
            <span>● v2.4.0 Stable</span>
        </div>
    </div>
</div>
