    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content complete-modal-content shadow-lg">
            <form asp-action="RecordPayment" method="post">
                <div class="modal-header border-0 px-4 pt-4 pb-2">
                    <div>
                        <h4 class="modal-title fw-bold" id="recordPaymentModalLabel">Record Payment</h4>
                        <div class="text-muted" id="paymentCustomerName"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 pb-4">
                    <div class="complete-modal-order mb-3">
                        <div class="d-flex justify-content-between"><span>Order total</span><strong id="paymentOrderTotal">&#8369;0.00</strong></div>
                        <div class="d-flex justify-content-between"><span>Already paid</span><strong id="paymentAlreadyPaid">&#8369;0.00</strong></div>
