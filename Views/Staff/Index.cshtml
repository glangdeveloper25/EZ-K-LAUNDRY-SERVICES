                        <button type="submit" class="btn btn-primary flex-fill py-2 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Save Actual Weight
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

