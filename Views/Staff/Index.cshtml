<!-- COMPLETE ORDER CONFIRMATION MODAL -->
<div class="modal fade" id="completeOrderModal" tabindex="-1" aria-labelledby="completeOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content complete-modal-content shadow-lg">
            <form asp-action="CompleteOrder" method="post">
                <div class="modal-body text-center p-4 p-md-5">
                    <div class="complete-modal-icon mb-4" aria-hidden="true">
                        <i class="bi bi-bag-check-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-2" id="completeOrderModalLabel">Complete this order?</h3>
                    <p class="text-muted mb-4">
                        Confirm that the laundry has been released to the customer.
                    </p>
                    <div class="complete-modal-order text-start mb-4">
                        <div class="small text-muted">Selected order</div>
                        <div class="fw-bold" id="completeOrderSummary">Order details</div>
                    </div>
                    <input type="hidden" name="bookingId" id="completeBookingId" />
                    <div class="d-grid gap-2 d-sm-flex">
                        <button type="button" class="btn btn-light border flex-fill py-2 fw-bold" data-bs-dismiss="modal">
                            Go Back
                        </button>
                        <button type="submit" class="btn btn-success flex-fill py-2 fw-bold">
