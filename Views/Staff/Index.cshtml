<!-- SCRIPT LOGIC (INCLUDING WALKIN REALTIME CALCULATOR) -->
<script>
    const actualWeightModal = document.getElementById('actualWeightModal');
    const actualWeightInput = document.getElementById('actualWeightInput');
    const kgPerLoad = @Model.KgPerLoad.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const loadsFor = weight => weight > 0 ? Math.ceil(weight / kgPerLoad) : 1;
    let actualWeightPerKgRate = 0;
    let actualWeightPerLoadRate = 0;
    let actualWeightFixedAmount = 0;
    let actualWeightRewardDiscount = 0;

    function projectedWeightTotal(newWeight) {
        return Math.max(0, actualWeightFixedAmount + (newWeight * actualWeightPerKgRate)
            + (loadsFor(newWeight) * actualWeightPerLoadRate) - actualWeightRewardDiscount);
    }

    function updateProjectedWeightTotal() {
        const newWeight = Number(actualWeightInput.value || 0);
        document.getElementById('projectedOrderTotal').textContent =
            `\u20B1${projectedWeightTotal(newWeight).toFixed(2)} (${loadsFor(newWeight)} load(s))`;
    }

    actualWeightModal.addEventListener('show.bs.modal', function (event) {
        const trigger = event.relatedTarget;
        const bookingId = trigger.getAttribute('data-booking-id');
        const reference = trigger.getAttribute('data-booking-reference');
        const customerName = trigger.getAttribute('data-customer-name');
        const currentWeight = Number(trigger.getAttribute('data-current-weight') || 0);
        actualWeightPerKgRate = Number(trigger.getAttribute('data-per-kg-rate') || 0);
        actualWeightPerLoadRate = Number(trigger.getAttribute('data-per-load-rate') || 0);
        actualWeightFixedAmount = Number(trigger.getAttribute('data-fixed-amount') || 0);
        actualWeightRewardDiscount = Number(trigger.getAttribute('data-reward-discount') || 0);

        document.getElementById('actualWeightBookingId').value = bookingId;
        document.getElementById('actualWeightOrderSummary').textContent = `${reference} - ${customerName}`;
        document.getElementById('previousWeightDisplay').textContent = `${currentWeight.toFixed(2)} kg`;
        document.getElementById('perKgRateDisplay').textContent = `\u20B1${actualWeightPerLoadRate.toFixed(2)}/load`
            + (actualWeightPerKgRate > 0 ? ` + \u20B1${actualWeightPerKgRate.toFixed(2)}/kg` : '');
        document.getElementById('fixedAmountDisplay').textContent = `\u20B1${actualWeightFixedAmount.toFixed(2)}`;
        document.getElementById('rewardDiscountDisplay').textContent = `\u20B1${actualWeightRewardDiscount.toFixed(2)}`;
        actualWeightInput.value = currentWeight.toFixed(2);
        updateProjectedWeightTotal();
    });

    actualWeightInput.addEventListener('input', updateProjectedWeightTotal);

    function confirmActualWeightUpdate() {
        const newWeight = Number(actualWeightInput.value || 0);
        return window.confirm(
            `Save ${newWeight.toFixed(2)} kg (${loadsFor(newWeight)} load(s)) as the actual weight? The recalculated total will be \u20B1${projectedWeightTotal(newWeight).toFixed(2)}.`
        );
    }

    const paymentModal = document.getElementById('recordPaymentModal');
    const paymentMethod = document.getElementById('paymentMethod');

    function updatePaymentMethodMessage() {
        const isGCash = paymentMethod.value === 'GCash';
        document.getElementById('gcashVerificationNote').hidden = !isGCash;
        document.getElementById('paymentSubmitButton').innerHTML = isGCash
            ? '<i class="bi bi-check-circle me-1"></i> Verify GCash as Paid'
            : '<i class="bi bi-check-circle me-1"></i> Record Cash Payment';
    }

    paymentModal.addEventListener('show.bs.modal', function (event) {
        const trigger = event.relatedTarget;
        const reference = trigger.getAttribute('data-booking-reference');
        const bookingCode = trigger.getAttribute('data-booking-code');
        const customerName = trigger.getAttribute('data-customer-name');
        const total = Number(trigger.getAttribute('data-total') || 0);
        const paid = Number(trigger.getAttribute('data-paid') || 0);
        const balance = Number(trigger.getAttribute('data-balance') || 0);
        const pendingGCash = Number(trigger.getAttribute('data-pending-gcash') || 0);
        const method = trigger.getAttribute('data-method') || 'Cash';

        document.getElementById('paymentBookingReference').value = reference;
        document.getElementById('paymentCustomerName').textContent = `${reference} (${bookingCode}) - ${customerName}`;
        document.getElementById('paymentOrderTotal').textContent = `₱${total.toFixed(2)}`;
        document.getElementById('paymentAlreadyPaid').textContent = `₱${paid.toFixed(2)}`;
        document.getElementById('paymentBalanceDue').textContent = `₱${balance.toFixed(2)}`;

        const amountInput = document.getElementById('paymentAmount');
        // A GCash payment already declared is verified as received; any amount above the
        // balance is recorded as a refund by the server.
        const verifyingGCash = method === 'GCash' && pendingGCash > 0;
        const suggestedAmount = verifyingGCash ? pendingGCash : balance;
        amountInput.value = suggestedAmount.toFixed(2);
        amountInput.max = Math.max(balance, verifyingGCash ? pendingGCash : 0).toFixed(2);
        paymentMethod.value = method;
        updatePaymentMethodMessage();
    });

    paymentMethod.addEventListener('change', updatePaymentMethodMessage);

    document.getElementById('completeOrderModal').addEventListener('show.bs.modal', function (event) {
        const trigger = event.relatedTarget;
        const bookingId = trigger.getAttribute('data-booking-id');
        const customerName = trigger.getAttribute('data-customer-name');

        document.getElementById('completeBookingId').value = bookingId;
        document.getElementById('completeOrderSummary').textContent = `#BK-${bookingId} · ${customerName}`;
    });

    function prepareCancellationReason(form) {
        const reason = window.prompt("Reason for cancelling this order:");
        if (reason === null) return false;

        const cleanedReason = reason.trim();
        if (cleanedReason.length < 3 || cleanedReason.length > 150) {
            window.alert("Please enter a reason between 3 and 150 characters.");
            return false;
        }

        if (!window.confirm("Cancel this order? The record will remain in history.")) return false;
        form.elements.reason.value = cleanedReason;
        return true;
    }

    function showSection(sectionId, element) {
        var sections = document.getElementsByClassName('dashboard-section');
        for (var i = 0; i < sections.length; i++) {
            sections[i].style.display = 'none';
        }
        document.getElementById(sectionId).style.display = 'block';
        var links = document.getElementsByClassName('nav-link-staff');
        for (var i = 0; i < links.length; i++) {
            links[i].classList.remove('active');
        }
        element?.classList.add('active');
    }

    // Client preview only. The server rechecks current prices, quantities and stock on save.
    const walkInRates = {
        'Washing': @WalkInPrice("Washing", 25m).ToString(System.Globalization.CultureInfo.InvariantCulture),
        'Drying': @WalkInPrice("Drying", 25m).ToString(System.Globalization.CultureInfo.InvariantCulture),
        'Folding': @WalkInPrice("Folding", 10m).ToString(System.Globalization.CultureInfo.InvariantCulture),
        'Powder': @WalkInPrice("Powder", 15m).ToString(System.Globalization.CultureInfo.InvariantCulture),
        'Downy': @WalkInPrice("Downy", 15m).ToString(System.Globalization.CultureInfo.InvariantCulture),
        'Rush Fee': @WalkInPrice("RushFee", 75m).ToString(System.Globalization.CultureInfo.InvariantCulture)
    };
    const walkInInventoryReady = @(Model.Inventory.IsReady ? "true" : "false");
    const walkInStock = { Powder: @(powderStock?.Quantity ?? 0), Downy: @(downyStock?.Quantity ?? 0) };
    let lastWalkInSupplyChoice = '';
    let walkInSubmitting = false;

    function updateWalkInSupply(sourceId, quantityId, groupId, itemName) {
        const source = document.getElementById(sourceId);
        const quantity = document.getElementById(quantityId);
        const isShop = source.value === 'Shop';
        document.getElementById(groupId).hidden = !isShop;
        quantity.disabled = !isShop;
        quantity.required = isShop;
        quantity.max = Math.max(1, Math.min(20, walkInStock[itemName]));
        quantity.setCustomValidity('');
        source.setCustomValidity('');
        if (!isShop) return 0;

        const pieces = Number(quantity.value);
        if (!walkInInventoryReady || walkInStock[itemName] <= 0) {
            source.setCustomValidity(`No shop ${itemName} stock is available. Check inventory or choose customer-provided supplies.`);
        } else if (!Number.isInteger(pieces) || pieces < 1 || pieces > 20) {
            quantity.setCustomValidity('Enter a whole number from 1 to 20 pieces.');
        } else if (pieces > walkInStock[itemName]) {
            quantity.setCustomValidity(`Only ${walkInStock[itemName]} piece(s) of ${itemName} are available.`);
        }
        return Number.isInteger(pieces) && pieces > 0 ? pieces : 0;
    }

    function syncWalkInRush() {
        const selfService = document.querySelector('input[name="serviceMode"]:checked')?.value === 'Self Service';
        const rush = document.getElementById('wRush');
        if (selfService) rush.checked = false;
        rush.disabled = selfService;
    }

    function calcWalkIn() {
        const weight = Number(document.getElementById('wWeight').value) || 0;
        const selectedServices = Array.from(document.querySelectorAll('.walkin-core-service:checked'), input => input.value);
        const powderPieces = updateWalkInSupply('walkInDetergentSource', 'walkInPowderQuantity', 'walkInPowderQuantityGroup', 'Powder');
        const downyPieces = updateWalkInSupply('walkInSoftenerSource', 'walkInDownyQuantity', 'walkInDownyQuantityGroup', 'Downy');
        const detergentSource = document.getElementById('walkInDetergentSource').value;
        const softenerSource = document.getElementById('walkInSoftenerSource').value;
        const hasShopSupplies = detergentSource === 'Shop' || softenerSource === 'Shop';
        const supplyChoice = `${detergentSource}:${powderPieces}|${softenerSource}:${downyPieces}`;
        const issueCheckbox = document.getElementById('walkInIssueSupplies');
        if (supplyChoice !== lastWalkInSupplyChoice || !hasShopSupplies) issueCheckbox.checked = false;
        lastWalkInSupplyChoice = supplyChoice;
        issueCheckbox.required = hasShopSupplies;
        issueCheckbox.disabled = !hasShopSupplies;
        document.getElementById('walkInIssueSuppliesGroup').hidden = !hasShopSupplies;

        let total = selectedServices.reduce((amount, service) => amount + walkInRates[service] * loadsFor(weight), 0);
        total += powderPieces * walkInRates.Powder + downyPieces * walkInRates.Downy;
        if (document.getElementById('wRush').checked) total += walkInRates['Rush Fee'];

        const stockChanges = [];
        if (detergentSource === 'Shop') stockChanges.push(`Powder: ${powderPieces} piece(s), remaining ${Math.max(0, walkInStock.Powder - powderPieces)}`);
        if (softenerSource === 'Shop') stockChanges.push(`Downy: ${downyPieces} piece(s), remaining ${Math.max(0, walkInStock.Downy - downyPieces)}`);
        document.getElementById('walkInStockDeduction').textContent = stockChanges.join(' | ');
        document.getElementById('walkin-total').textContent = '\u20B1' + total.toFixed(2);
        document.getElementById('hTotalAmount').value = total.toFixed(2);
        document.getElementById('walkInServices').value = selectedServices.join(', ');
    }

    document.getElementById('walkInForm').addEventListener('submit', function (event) {
        if (walkInSubmitting) {
            event.preventDefault();
            return;
        }
        calcWalkIn();
        if (!document.getElementById('walkInServices').value) {
            event.preventDefault();
            window.alert('Please select at least one laundry service: Washing, Drying, or Folding.');
            document.getElementById('w1').focus();
            return;
        }
        if (!this.reportValidity()) {
            event.preventDefault();
            return;
        }

        const sourceLabel = (sourceId, quantityId) => {
            const source = document.getElementById(sourceId).value;
            return source === 'Shop'
                ? `Shop - ${document.getElementById(quantityId).value} piece(s)`
                : source === 'Customer' ? 'Customer-provided (no charge or stock deduction)' : 'Not needed';
        };
        const review = [
            'Save this walk-in order?',
            `Customer: ${document.getElementById('walkInCustomerName').value.trim()}`,
            `Services: ${document.getElementById('walkInServices').value}`,
            `Actual weight: ${document.getElementById('wWeight').value} kg`,
            `Powder: ${sourceLabel('walkInDetergentSource', 'walkInPowderQuantity')}`,
            `Downy: ${sourceLabel('walkInSoftenerSource', 'walkInDownyQuantity')}`,
            `Rush: ${document.getElementById('wRush').checked ? 'Yes' : 'No'}`,
            `Total: ${document.getElementById('walkin-total').textContent}`,
            document.getElementById('walkInIssueSupplies').checked ? 'The issued shop pieces will be deducted from inventory.' : 'No shop inventory will be deducted.'
        ];
        if (!window.confirm(review.join('\n'))) {
            event.preventDefault();
            return;
        }
        walkInSubmitting = true;
        document.getElementById('walkInSubmit').disabled = true;
        document.getElementById('walkInSubmit').textContent = 'Saving order...';
    });

    window.addEventListener('pageshow', function () {
        walkInSubmitting = false;
        document.getElementById('walkInSubmit').disabled = false;
        document.getElementById('walkInSubmit').textContent = 'Process and Save Walk-in Order';
        calcWalkIn();
    });

    syncWalkInRush();
    calcWalkIn();
    @if (Model.OpenWalkIn)
    {
        <text>showSection('walkin-section', document.getElementById('walkInNavigation'));</text>
    }
</script>
<script src="~/js/dashboard-navigation.js" asp-append-version="true" data-preserve-current-section="@(Model.OpenWalkIn ? "true" : "false")"></script>
<script src="~/js/staff-audio-alert.js" asp-append-version="true"
        data-status-url="@Url.Action("PendingBookingStatus", "Staff")"
        data-latest-id="@(Model.NewBookings.Count > 0 ? Model.NewBookings.Max(b => b.Id) : 0)"></script>
